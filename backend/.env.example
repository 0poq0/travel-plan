
# LLM配置 (LangChain ChatOpenAI, 兼容任意OpenAI格式端点)
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 命名
# 模型名称 (OpenAI: gpt-4o/gpt-4o-mini, DeepSeek: deepseek-chat, 通义: qwen-plus ...)
LLM_MODEL_ID=deepseek-chat

# API密钥 (填写你自己的密钥; 不要提交含真实密钥的 .env)
LLM_API_KEY=your_llm_api_key_here

# 服务地址 (OpenAI官方端点留空即可; DeepSeek填 https://api.deepseek.com/v1)
LLM_BASE_URL=https://api.deepseek.com/v1

# 温度 (可选, 默认0.7)
LLM_TEMPERATURE=0.7

# 超时时间 (可选, 默认60秒)
LLM_TIMEOUT=60.0

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
# 必须同时包含 localhost 与 127.0.0.1 两种写法: 浏览器视其为不同来源,
# 只放行 localhost 的话, 从 127.0.0.1:5173 打开页面会报 Network Error
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 日志级别
LOG_LEVEL=INFO

# 高德地图API配置 (在 https://lbs.amap.com 申请「Web服务」类型 Key)
AMAP_API_KEY=your_amap_web_service_key_here

# RAG 知识库配置 (千问 text-embedding-v4, 阿里云百炼 DashScope)
# 去 bailian.console.aliyun.com 免费开通获取; 留空则 RAG 自动禁用, 不影响主流程
DASHSCOPE_API_KEY=

# 嵌入模型名 (可选, 默认 text-embedding-v4)
EMBEDDING_MODEL=text-embedding-v4
